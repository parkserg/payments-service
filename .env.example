# Ключ для заголовка X-API-Key
API_KEY=dev-secret-key

# Порты на хосте (поменяйте, если заняты)
API_PORT=8000
POSTGRES_PORT=5432
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
WEBHOOK_MOCK_PORT=8090

# Эмуляция шлюза
GATEWAY_MIN_DELAY=2
GATEWAY_MAX_DELAY=5
GATEWAY_SUCCESS_RATE=0.9

# Retry: всего попыток и базовая задержка в секундах (удваивается)
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=2
